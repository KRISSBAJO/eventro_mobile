# Copy to .env.local (git-ignored) and adjust. Expo inlines EXPO_PUBLIC_* values at build time,
# so restart `npx expo start` after changing them.

# The Eventro API (eventro-be). On a phone this must be your computer's LAN address, not 127.0.0.1,
# e.g. http://192.168.1.20:4000/api/v1 (and the API must listen on 0.0.0.0: start it with HOST=0.0.0.0).
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1

# The website, for help and legal pages and the browser checkout fallback.
EXPO_PUBLIC_WEB_URL=http://127.0.0.1:3500

# Stripe publishable key (pk_test_… in development) for the in-app card sheet. Leave empty to finish
# card payments on the website instead. Only needed when the API has STRIPE_SECRET_KEY set.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
