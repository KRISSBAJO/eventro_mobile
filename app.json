{
  "expo": {
    "name": "Eventro",
    "slug": "eventro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventro",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f0a0b",
    "primaryColor": "#ff4d3d",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.eventro.mobile"
    },
    "android": {
      "package": "app.eventro.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f0a0b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Eventro",
      "backgroundColor": "#0f0a0b",
      "themeColor": "#0f0a0b"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f0a0b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eventro uses your location only when you ask, to show the events closest to you."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#ff4d3d",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Eventro uses the camera to scan ticket QR codes at the door.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eventro opens your photos only when you choose one, to upload it as your event’s cover photo.",
          "cameraPermission": "Eventro uses the camera to scan ticket QR codes at the door.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
