{
  "expo": {
    "name": "Omoshow",
    "slug": "omoshow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventro",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0f0a0b",
    "primaryColor": "#ff4d3d",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omoshow.app"
    },
    "android": {
      "package": "com.omoshow.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f0a0b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Omoshow",
      "backgroundColor": "#0f0a0b",
      "themeColor": "#0f0a0b"
    },
    "plugins": [
      "expo-router",
      "./withStripeReleaseLint",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f0a0b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Omoshow uses your location only when you ask, to show the events closest to you."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#ff4d3d",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Omoshow uses the camera to scan ticket QR codes at the door.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Omoshow opens your photos only when you choose one, to upload it as your event’s cover photo.",
          "cameraPermission": "Omoshow uses the camera to scan ticket QR codes at the door.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "gatherplus",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "eb61f69a-f495-483a-970f-eb9bd5a1841a"
      }
    }
  }
}
