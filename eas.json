{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.omoshow.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://omoshow.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.omoshow.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://omoshow.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
